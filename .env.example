# Copy to .env for local runs. Secrets are injected from a secret store in other environments.

# Spring profile: local (default) | production. production refuses fake AI, header auth and seeded data.
SPRING_PROFILES_ACTIVE=local

# Database (docs/architecture/non-functional.md)
DATABASE_URL=jdbc:postgresql://localhost:5432/proofu
DATABASE_USERNAME=proofu
DATABASE_PASSWORD=proofu

# Object storage — provider TBD
OBJECT_BUCKET=
OBJECT_REGION=

# Authentication (ADR-0010). AUTH_MODE=header is the interim local mode; oidc needs everything below.
# Local IdP: docker compose -f infra/docker-compose.yml --profile auth up -d  (dev@proofu.local / devpass)
AUTH_MODE=header
OIDC_ISSUER=http://localhost:8180/realms/proofu
OIDC_JWKS_URI=http://localhost:8180/realms/proofu/protocol/openid-connect/certs
OIDC_AUDIENCE=proofu-api
OIDC_CLIENT_ID=proofu-web
OIDC_CLIENT_SECRET=proofu-web-local-secret
# ≥ 32 random characters; encrypts the web session cookie. Rotate to invalidate every session.
SESSION_SECRET=change-me-to-a-long-random-string-32chars
APP_ORIGIN=http://localhost:3000

# AI (ADR-0008) — never log these
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-opus-5
AI_WORKSPACE_MONTHLY_BUDGET_USD=5
AI_DAILY_BUDGET_USD=50

# Worker
WORKER_POLL_INTERVAL=2s
WORKER_BATCH_SIZE=5

# Observability
OTEL_ENDPOINT=
RELEASE_VERSION=local
